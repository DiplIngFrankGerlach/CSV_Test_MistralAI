    var ExpressionEvaluator evaluator;
    var Math math;

    // Testausdrücke
    var String_16 expressions[10];
    expressions[0].assign("3 + 4 * 2");
    expressions[1].assign("(3 + 4) * 2");
    expressions[2].assign("sinus(0.5)+cosinus(0.5)");
    expressions[3].assign("sqrt(16.0)+pow(2.0,3.0)");
    expressions[4].assign("abs(-5.5)*2.0");
    expressions[5].assign("log(10)+1");
    expressions[6].assign("2*(3+(4*5))");
    expressions[7].assign("-10+20/2");
    expressions[8].assign("10.123");
    expressions[9].assign("sqrt(10.123)");

    pfc.fstr("=== Sappeur Mathematik-Auswerter ===").pr();

    var String_16 stest("sqrt(10.123)");
    evaluator.setExpression(stest);
    var double result0 = evaluator.evaluate();
    pfc.fstr("Ausdruck: $ = $").sa(stest).sa(result0).pr();

    stest.assign("sinus(cosinus(3.77))");
    evaluator.setExpression(stest);
    result0 = evaluator.evaluate();
    pfc.fstr("Ausdruck: $ = $").sa(stest).sa(result0).pr();

    stest.assign("sinus(cosinus(3.77) * -1.2345)");
    evaluator.setExpression(stest);
    result0 = evaluator.evaluate();
    pfc.fstr("Ausdruck: $ = $").sa(stest).sa(result0).pr();


    for(var int i = 0; i < expressions.sz; i++)
    {
        evaluator.setExpression(expressions[i]);
        var double result = evaluator.evaluate();
        pfc.fstr("Ausdruck: $ = $").sa(expressions[i]).sa(result).pr();
    }

    var *PrintfClass pfcs[] = new PrintfClass[100];

   return 1;
