Import { "Base64.ad", "Base64Test.ad" }

/**
 * @brief Compare binary arrays by length and value.
 * @return 1 if equal, otherwise 0.
 */
int Base64Test::equalArrays(&*char left[], &*char right[])
{
    if(left.sz != right.sz) { return 0; }
    for(var int i=0;i<left.sz;i++)
    {
        if(left[i] != right[i]) { return 0; }
    }
    return 1;
}

/**
 * @brief Exercise RFC 4648 examples, binary roundtrip, and invalid padding.
 * @param result Set to 1 on success or 0 on a failed test.
 */
void Base64Test::run(&int result)
{
    result=0;
    var Base64 b64;
    var int length=0;
    var *char src[]=new char[6];
    src[0]='f'; src[1]='o'; src[2]='o';
    src[3]='b'; src[4]='a'; src[5]='r';
    var *char encoded[];
    if(b64.encode(src,encoded,length) != 1) { return; }
    if(length != 8) { return; }
    var *char expected[]=new char[8];
    expected[0]='Z'; expected[1]='m'; expected[2]='9'; expected[3]='v';
    expected[4]='Y'; expected[5]='m'; expected[6]='F'; expected[7]='y';
    if(this.equalArrays(encoded,expected) != 1) { return; }

    var *char decoded[];
    if(b64.decode(encoded,decoded,length) != 1) { return; }
    if(length != 6) { return; }
    if(this.equalArrays(decoded,src) != 1) { return; }

    var *char binary[]=new char[5];
    binary[0]=cast(char,0);
    binary[1]=cast(char,255);
    binary[2]=cast(char,128);
    binary[3]=cast(char,1);
    binary[4]=cast(char,0);
    var *char binaryEncoded[];
    var *char binaryDecoded[];
    if(b64.encode(binary,binaryEncoded,length) != 1) { return; }
    if(b64.decode(binaryEncoded,binaryDecoded,length) != 1) { return; }
    if(length != 5) { return; }
    if(this.equalArrays(binary,binaryDecoded) != 1) { return; }

    // Noncanonical: second symbol has nonzero unused low four bits.
    var *char invalid1[]=new char[4];
    invalid1[0]='Z'; invalid1[1]='h'; invalid1[2]='='; invalid1[3]='=';
    if(b64.decode(invalid1,decoded,length) != 0) { return; }
    if(length != 0) { return; }

    // A padding marker is illegal in a nonfinal quantum.
    var *char invalid2[]=new char[8];
    invalid2[0]='Z'; invalid2[1]='g'; invalid2[2]='='; invalid2[3]='=';
    invalid2[4]='Z'; invalid2[5]='g'; invalid2[6]='='; invalid2[7]='=';
    if(b64.decode(invalid2,decoded,length) != 0) { return; }

    // Nonalphabet whitespace is rejected.
    var *char invalid3[]=new char[4];
    invalid3[0]='Z'; invalid3[1]='g'; invalid3[2]='='; invalid3[3]=' ';
    if(b64.decode(invalid3,decoded,length) != 0) { return; }

    var *char empty[]=new char[0];
    var *char emptyEncoded[];
    var *char emptyDecoded[];
    if(b64.encode(empty,emptyEncoded,length) != 1) { return; }
    if(length != 0) { return; }
    if(b64.decode(emptyEncoded,emptyDecoded,length) != 1) { return; }
    if(length != 0) { return; }
    result=1;
}
