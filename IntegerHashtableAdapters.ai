Import{
    "IntegerHashtableAdapters.ad"
}

/**
 * @brief Return the int key unchanged as its signed hash.
 * The hash table normalizes a negative remainder when choosing a slot.
 * The key is never negated, so the minimum signed int is supported.
 */
int IntKeyAdapter::hash(&int key)
{
    return key;
}

/** @brief Return 1 for equal int keys and 0 otherwise. */
int IntKeyAdapter::equals(&int a, &int b)
{
    if(a==b)
    {
        return 1;
    }
    return 0;
}

/** @brief Copy an int key by value; self-copy is valid. */
void IntKeyAdapter::copy(&int dst, &int src)
{
    dst=src;
}

/**
 * @brief Reset an int key slot to zero.
 * Primitive keys own no resources. The table tracks occupancy separately.
 */
void IntKeyAdapter::destroy(&int target)
{
    target=0;
}

/** @brief Copy an int value; self-copy is valid. */
void IntValueAdapter::copy(&int dst, &int src)
{
    dst=src;
}

/** @brief Reset an int value slot to zero; no deallocation is needed. */
void IntValueAdapter::destroy(&int target)
{
    target=0;
}

/**
 * @brief Reduce a longlong key to a safely representable int hash.
 * Reduction precedes the cast. The remainder fits in a signed 32-bit int.
 * The calculation supports the minimum signed longlong without negation.
 * Negative hashes are normalized by the existing hash table.
 */
int LonglongKeyAdapter::hash(&longlong key)
{
    var longlong modulus=2147483647;
    var longlong remainder=key % modulus;
    var int result=cast(int,remainder);
    return result;
}

/** @brief Compare the complete longlong keys; return 1 or 0. */
int LonglongKeyAdapter::equals(&longlong a, &longlong b)
{
    if(a==b)
    {
        return 1;
    }
    return 0;
}

/** @brief Copy a longlong key without narrowing; self-copy is valid. */
void LonglongKeyAdapter::copy(&longlong dst, &longlong src)
{
    dst=src;
}

/**
 * @brief Reset a longlong key slot to zero.
 * Primitive keys own no resources. The table tracks occupancy separately.
 */
void LonglongKeyAdapter::destroy(&longlong target)
{
    target=0;
}

/** @brief Copy a longlong value without narrowing; self-copy is valid. */
void LonglongValueAdapter::copy(&longlong dst, &longlong src)
{
    dst=src;
}

/** @brief Reset a longlong value slot to zero; no deallocation is needed. */
void LonglongValueAdapter::destroy(&longlong target)
{
    target=0;
}
