Import{
    "SimpleString.ad"
}

/**
 * @brief Constructs an empty mutable string with an initial 16-byte capacity.
 */
SimpleString::SimpleString()
{
    _length=0;
    _capacity=16;
    _data=new char[17];
    _data[0]='\0';
}

/**
 * @brief Constructs a string from a NUL-terminated or bounded char array.
 * @param text Input characters; scanning stops at NUL or array boundary.
 */
SimpleString::SimpleString(&char text[])
{
    _length=0;
    _capacity=16;
    _data=new char[17];
    _data[0]='\0';
    this.assign(text);
}

/**
 * @brief Returns the number of characters stored.
 * @return Current byte length, excluding the terminator.
 */
int SimpleString::length()
{
    return _length;
}

/**
 * @brief Checks whether the string has no characters.
 * @return 1 for empty; otherwise 0.
 */
int SimpleString::isEmpty()
{
    if(_length==0){return 1;}
    return 0;
}

/**
 * @brief Returns the usable buffer capacity.
 * @return Available capacity, excluding the terminator.
 */
int SimpleString::capacity()
{
    return _capacity;
}

/**
 * @brief Clears content without releasing the allocated buffer.
 */
void SimpleString::clear()
{
    _length=0;
    _data[0]='\0';
}

/**
 * @brief Ensures at least the specified buffer capacity if representable.
 * @param minimumCapacity Requested capacity, excluding the terminator.
 */
void SimpleString::reserve(int minimumCapacity)
{
    // Capacity excludes the terminating NUL character.
    if(minimumCapacity<=_capacity){return;}
    if(minimumCapacity<0){return;}
    if(minimumCapacity>2147483646){return;}

    var int newCapacity=_capacity;
    while(newCapacity<minimumCapacity)
    {
        if(newCapacity>1073741823)
        {
            newCapacity=minimumCapacity;
        }
        else
        {
            newCapacity=newCapacity*2;
        }
    }

    var *char newData[]=new char[newCapacity+1];
    for(var int i=0;i<_length;i++)
    {
        newData[i]=_data[i];
    }
    newData[_length]='\0';
    _data=newData;
    _capacity=newCapacity;
}

/**
 * @brief Replaces content with a bounded char array, including alias-safe input.
 * @param text Source characters.
 */
void SimpleString::assign(&char text[])
{
    // Stage the input so an input alias of the current data stays valid.
    var SimpleString temporary;
    temporary.append(text);
    this.assign(temporary);
}

/**
 * @brief Replaces content with another string.
 * @param other Source string; self-assignment is supported.
 */
void SimpleString::assign(&SimpleString other)
{
    // Read first, overwrite only after necessary allocation.
    var int count=other.length();
    this.reserve(count);
    for(var int i=0;i<count;i++)
    {
        _data[i]=other.charAt(i);
    }
    _length=count;
    _data[_length]='\0';
}

/**
 * @brief Appends characters from a bounded char array.
 * @param text Source characters; embedded NUL marks the end.
 */
void SimpleString::append(&char text[])
{
    // A Sappeur char-array argument is bounds-checked via .sz.
    // Stop at NUL; a non-NUL-terminated array is accepted as full length.
    var int count=0;
    var int scanning=1;
    while((count<text.sz) && (scanning==1))
    {
        if(text[count]=='\0')
        {
            scanning=0;
        }
        else
        {
            count=count+1;
        }
    }
    var int room=2147483646 - _length;
    if(count>room){return;}
    if(count==0){return;}

    // Stage the characters before growing, allowing alias-safe append.
    var *char sourceCopy[]=new char[count];
    for(var int j=0;j<count;j++)
    {
        sourceCopy[j]=text[j];
    }
    var int newLength=_length+count;
    this.reserve(newLength);
    for(var int k=0;k<count;k++)
    {
        _data[_length+k]=sourceCopy[k];
    }
    _length=newLength;
    _data[_length]='\0';
}

/**
 * @brief Appends the contents of another string.
 * @param other Source string; self-append is supported.
 */
void SimpleString::append(&SimpleString other)
{
    var int count=other.length();
    var int room=2147483646 - _length;
    if(count>room){return;}
    var int oldLength=_length;
    var int newLength=oldLength+count;
    this.reserve(newLength);
    for(var int i=0;i<count;i++)
    {
        _data[oldLength+i]=other.charAt(i);
    }
    _length=newLength;
    _data[_length]='\0';
}

/**
 * @brief Appends one non-NUL character.
 * @param value Character to append; NUL is ignored.
 */
void SimpleString::appendChar(char value)
{
    // Embedded NULs are intentionally not supported.
    if(value=='\0'){return;}
    if(_length>=2147483646){return;}
    var int newLength=_length+1;
    this.reserve(newLength);
    _data[_length]=value;
    _length=newLength;
    _data[_length]='\0';
}

/**
 * @brief Gets a character at the specified zero-based index.
 * @param index Zero-based character index.
 * @return Character, or NUL for an invalid index.
 */
char SimpleString::charAt(int index)
{
    if(index<0){return '\0';}
    if(index>=_length){return '\0';}
    return _data[index];
}

/**
 * @brief Replaces a character at the specified index.
 * @param index Zero-based character index.
 * @param value Replacement character; NUL is disallowed.
 * @return 1 on success; otherwise 0.
 */
int SimpleString::setCharAt(int index,char value)
{
    if(index<0){return 0;}
    if(index>=_length){return 0;}
    if(value=='\0'){return 0;}
    _data[index]=value;
    return 1;
}

/**
 * @brief Tests bytewise equality with another string.
 * @param other String to compare.
 * @return 1 if equal; otherwise 0.
 */
int SimpleString::equals(&SimpleString other)
{
    var int count=other.length();
    if(_length!=count){return 0;}
    for(var int i=0;i<_length;i++)
    {
        if(_data[i]!=other.charAt(i)){return 0;}
    }
    return 1;
}

/**
 * @brief Tests bytewise equality with a character array or literal.
 * @param text Characters to compare.
 * @return 1 if equal; otherwise 0.
 */
int SimpleString::equals(&char text[])
{
    var SimpleString other(text);
    return this.equals(other);
}

/**
 * @brief Compares two strings in lexicographic byte order.
 * @param other String to compare.
 * @return -1, 0, or 1 depending on the comparison.
 */
int SimpleString::compareTo(&SimpleString other)
{
    var int otherLength=other.length();
    var int minimum=_length;
    if(otherLength<minimum){minimum=otherLength;}
    for(var int i=0;i<minimum;i++)
    {
        var int a=cast(int,_data[i]);
        var int b=cast(int,other.charAt(i));
        if(a<b){return -1;}
        if(a>b){return 1;}
    }
    if(_length<otherLength){return -1;}
    if(_length>otherLength){return 1;}
    return 0;
}

/**
 * @brief Tests whether the string starts with the given prefix.
 * @param prefix Prefix to check.
 * @return 1 if matched; otherwise 0.
 */
int SimpleString::startsWith(&SimpleString prefix)
{
    var int n=prefix.length();
    if(n>_length){return 0;}
    for(var int i=0;i<n;i++)
    {
        if(_data[i]!=prefix.charAt(i)){return 0;}
    }
    return 1;
}

/**
 * @brief Tests whether the string ends with the given suffix.
 * @param suffix Suffix to check.
 * @return 1 if matched; otherwise 0.
 */
int SimpleString::endsWith(&SimpleString suffix)
{
    var int n=suffix.length();
    if(n>_length){return 0;}
    var int offset=_length - n;
    for(var int i=0;i<n;i++)
    {
        if(_data[offset+i]!=suffix.charAt(i)){return 0;}
    }
    return 1;
}

/**
 * @brief Finds the first occurrence of another string.
 * @param needle Substring to find.
 * @return Zero-based index, or -1 when absent.
 */
int SimpleString::indexOf(&SimpleString needle)
{
    return this.indexOfFrom(needle,0);
}

/**
 * @brief Finds a substring starting at a specified position.
 * @param needle Substring to find.
 * @param fromIndex Starting position; negative values are clamped to zero.
 * @return First matching index, or -1 when absent.
 */
int SimpleString::indexOfFrom(&SimpleString needle,int fromIndex)
{
    var int n=needle.length();
    var int start=fromIndex;
    if(start<0){start=0;}
    if(n==0)
    {
        if(start>_length){return _length;}
        return start;
    }
    if(n>_length){return -1;}
    var int limit=_length - n;
    for(var int i=start;i<=limit;i++)
    {
        var int matched=1;
        var int j=0;
        while((j<n) && (matched==1))
        {
            if(_data[i+j]!=needle.charAt(j))
            {
                matched=0;
            }
            else
            {
                j=j+1;
            }
        }
        if(matched==1){return i;}
    }
    return -1;
}

/**
 * @brief Finds the last occurrence of a substring.
 * @param needle Substring to find.
 * @return Last matching index, or -1 when absent.
 */
int SimpleString::lastIndexOf(&SimpleString needle)
{
    var int n=needle.length();
    if(n==0){return _length;}
    if(n>_length){return -1;}
    var int start=_length - n;
    // Avoid a decrementing loop that underflows below zero.
    var int i=start;
    while(i>=0)
    {
        var int matched=1;
        var int j=0;
        while((j<n) && (matched==1))
        {
            if(_data[i+j]!=needle.charAt(j))
            {
                matched=0;
            }
            else
            {
                j=j+1;
            }
        }
        if(matched==1){return i;}
        i=i - 1;
    }
    return -1;
}

/**
 * @brief Checks whether a substring appears within the string.
 * @param needle Substring to find.
 * @return 1 if present; otherwise 0.
 */
int SimpleString::contains(&SimpleString needle)
{
    var int pos=this.indexOf(needle);
    if(pos>=0){return 1;}
    return 0;
}

/**
 * @brief Extracts a substring into an output string.
 * @param beginIndex Inclusive starting index.
 * @param endIndex Exclusive ending index.
 * @param result Receives the extracted substring on success.
 * @return 1 if range is valid; otherwise 0.
 */
int SimpleString::substring(int beginIndex,int endIndex,&SimpleString result)
{
    if(beginIndex<0){return 0;}
    if(endIndex<beginIndex){return 0;}
    if(endIndex>_length){return 0;}
    var SimpleString temporary;
    for(var int i=beginIndex;i<endIndex;i++)
    {
        temporary.appendChar(_data[i]);
    }
    result.assign(temporary);
    return 1;
}

/**
 * @brief Replaces each matching character in an output string.
 * @param oldChar Character to replace.
 * @param newChar Replacement character.
 * @param result Receives the transformed value.
 */
void SimpleString::replace(char oldChar,char newChar,&SimpleString result)
{
    // Only character-to-character replacement, not Java regex replacement.
    var SimpleString temporary;
    for(var int i=0;i<_length;i++)
    {
        var char current=_data[i];
        if(current==oldChar){current=newChar;}
        temporary.appendChar(current);
    }
    result.assign(temporary);
}

/**
 * @brief Converts ASCII uppercase characters to lowercase.
 * @param result Receives the transformed value.
 */
void SimpleString::toLowerCase(&SimpleString result)
{
    var SimpleString temporary;
    for(var int i=0;i<_length;i++)
    {
        var char current=_data[i];
        if((current>='A') && (current<='Z'))
        {
            var int code=cast(int,current);
            code=code+32;
            current=cast(char,code);
        }
        temporary.appendChar(current);
    }
    result.assign(temporary);
}

/**
 * @brief Converts ASCII lowercase characters to uppercase.
 * @param result Receives the transformed value.
 */
void SimpleString::toUpperCase(&SimpleString result)
{
    var SimpleString temporary;
    for(var int i=0;i<_length;i++)
    {
        var char current=_data[i];
        if((current>='a') && (current<='z'))
        {
            var int code=cast(int,current);
            code=code - 32;
            current=cast(char,code);
        }
        temporary.appendChar(current);
    }
    result.assign(temporary);
}

/**
 * @brief Classifies ASCII spaces, tabs, line feeds, and carriage returns.
 * @param value Character to classify.
 * @return 1 for supported whitespace; otherwise 0.
 */
int SimpleString::isTrimSpace(char value)
{
    // Rule 19: perform casts outside conditional expressions.
    // Rule 20: use switch instead of repeated OR conditions.
    var int code=cast(int,value);
    switch(code)
    {
        case 32: {return 1;}; // space
        case 9:  {return 1;}; // tab
        case 10: {return 1;}; // LF
        case 13: {return 1;}; // CR
        default: {return 0;};
    }
    return 0;
}

/**
 * @brief Removes supported ASCII whitespace from both ends.
 * @param result Receives trimmed text.
 */
void SimpleString::trim(&SimpleString result)
{
    var int first=0;
    var int last=_length;
    var int stripping=1;
    while((first<last) && (stripping==1))
    {
        var char c=_data[first];
        var int whitespace=this.isTrimSpace(c);
        if(whitespace==1)
        {
            first=first+1;
        }
        else
        {
            stripping=0;
        }
    }
    stripping=1;
    while((last>first) && (stripping==1))
    {
        var int previous=last - 1;
        var char c=_data[previous];
        var int whitespace=this.isTrimSpace(c);
        if(whitespace==1)
        {
            last=previous;
        }
        else
        {
            stripping=0;
        }
    }
    this.substring(first,last,result);
}

/**
 * @brief Copies content into a NUL-terminated output buffer.
 * @param destination Destination buffer.
 * @return 1 when the destination fits; otherwise 0.
 */
int SimpleString::toCharArray(&char destination[])
{
    var int required=_length+1;
    if(destination.sz<required){return 0;}
    for(var int i=0;i<_length;i++)
    {
        destination[i]=_data[i];
    }
    destination[_length]='\0';
    return 1;
}

// Literal / character-array overloads. A literal can be passed directly
// as &char[]; each wrapper delegates to the existing string implementation.
/**
 * @brief Compares this string to a character array or literal.
 * @param text Characters to compare.
 * @return -1, 0, or 1 depending on the comparison.
 */
int SimpleString::compareTo(&char text[])
{
    var SimpleString other(text);
    return this.compareTo(other);
}

/**
 * @brief Tests a prefix supplied as an array or literal.
 * @param prefix Prefix to check.
 * @return 1 if matched; otherwise 0.
 */
int SimpleString::startsWith(&char prefix[])
{
    var SimpleString other(prefix);
    return this.startsWith(other);
}

/**
 * @brief Tests a suffix supplied as an array or literal.
 * @param suffix Suffix to check.
 * @return 1 if matched; otherwise 0.
 */
int SimpleString::endsWith(&char suffix[])
{
    var SimpleString other(suffix);
    return this.endsWith(other);
}

/**
 * @brief Finds the first occurrence of a literal or char array.
 * @param needle Substring to find.
 * @return Zero-based index, or -1 when absent.
 */
int SimpleString::indexOf(&char needle[])
{
    var SimpleString other(needle);
    return this.indexOf(other);
}

/**
 * @brief Finds a literal or char array from a given position.
 * @param needle Substring to find.
 * @param fromIndex Starting position.
 * @return First matching index, or -1 when absent.
 */
int SimpleString::indexOfFrom(&char needle[],int fromIndex)
{
    var SimpleString other(needle);
    return this.indexOfFrom(other,fromIndex);
}

/**
 * @brief Finds the last occurrence of a literal or char array.
 * @param needle Substring to find.
 * @return Last matching index, or -1 when absent.
 */
int SimpleString::lastIndexOf(&char needle[])
{
    var SimpleString other(needle);
    return this.lastIndexOf(other);
}

/**
 * @brief Checks whether a literal or char array appears in the string.
 * @param needle Substring to find.
 * @return 1 if present; otherwise 0.
 */
int SimpleString::contains(&char needle[])
{
    var SimpleString other(needle);
    return this.contains(other);
}
