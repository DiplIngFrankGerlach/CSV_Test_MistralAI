Import{
    "SimpleString.ad",
    "SimpleStringTest.ad"
}

// Writes 1 on success; negative values identify failing checks.
/**
 * @brief Runs SimpleString regression tests, including literal overloads.
 * @param result Receives 1 on success or a negative identifier for the first failed check.
 * @note Uses a reference output to satisfy Sappeur static-call restrictions (Rule 21).
 */
void SimpleStringTest::run(&int result)
{
    var SimpleString s("  Hello World  ");
    if(s.length()!=15){result=-1;return;}
    if(s.charAt(2)!='H'){result=-2;return;}
    if(s.charAt(99)!='\0'){result=-3;return;}
    var SimpleString prefix("  He");
    if(s.startsWith(prefix)!=1){result=-4;return;}
    var SimpleString suffix("  ");
    if(s.endsWith(suffix)!=1){result=-5;return;}

    var SimpleString trimmed;
    s.trim(trimmed);
    if(trimmed.equals("Hello World")!=1){result=-6;return;}
    var SimpleString needle("lo");
    if(trimmed.indexOf(needle)!=3){result=-7;return;}
    if(trimmed.lastIndexOf(needle)!=3){result=-8;return;}
    if(trimmed.contains(needle)!=1){result=-9;return;}

    var SimpleString piece;
    if(trimmed.substring(6,11,piece)!=1){result=-10;return;}
    if(piece.equals("World")!=1){result=-11;return;}
    if(trimmed.substring(3,20,piece)!=0){result=-12;return;}
    if(piece.equals("World")!=1){result=-13;return;}

    var SimpleString upper;
    trimmed.toUpperCase(upper);
    if(upper.equals("HELLO WORLD")!=1){result=-14;return;}
    upper.toLowerCase(upper);
    if(upper.equals("hello world")!=1){result=-15;return;}

    var SimpleString replaced;
    trimmed.replace('o','0',replaced);
    if(replaced.equals("Hell0 W0rld")!=1){result=-16;return;}

    var SimpleString joined("ab");
    joined.append(joined);
    if(joined.equals("abab")!=1){result=-17;return;}
    joined.appendChar('!');
    if(joined.equals("abab!")!=1){result=-18;return;}
    if(joined.setCharAt(4,'?')!=1){result=-19;return;}
    if(joined.equals("abab?")!=1){result=-20;return;}

    var SimpleString earlier("abc");
    var SimpleString later("abd");
    if(earlier.compareTo(later)>=0){result=-21;return;}
    if(later.compareTo(earlier)<=0){result=-22;return;}
    if(earlier.compareTo(earlier)!=0){result=-23;return;}

    var char array[32];
    if(joined.toCharArray(array)!=1){result=-24;return;}
    if(array[4]!='?'){result=-25;return;}
    if(array[5]!='\0'){result=-26;return;}

    var SimpleString empty;
    if(empty.isEmpty()!=1){result=-27;return;}
    if(earlier.indexOf(empty)!=0){result=-28;return;}
    if(earlier.lastIndexOf(empty)!=3){result=-29;return;}
    // Direct literal overloads, without temporary objects at call sites.
    if(trimmed.startsWith("Hello")!=1){result=-30;return;}
    if(trimmed.endsWith("World")!=1){result=-31;return;}
    if(trimmed.indexOf("lo")!=3){result=-32;return;}
    if(trimmed.indexOfFrom("l",4)!=9){result=-33;return;}
    if(trimmed.lastIndexOf("l")!=9){result=-34;return;}
    if(trimmed.contains("o W")!=1){result=-35;return;}
    if(trimmed.contains("XYZ")!=0){result=-36;return;}
    if(trimmed.compareTo("Hello World")!=0){result=-37;return;}
    if(trimmed.compareTo("Hello Worle")>=0){result=-38;return;}
    if(trimmed.equals("Hello World")!=1){result=-39;return;}
    var SimpleString withLiteral("a");
    withLiteral.append("bc");
    if(withLiteral.equals("abc")!=1){result=-40;return;}
    withLiteral.assign("new");
    if(withLiteral.equals("new")!=1){result=-41;return;}
    if(trimmed.indexOf("")!=0){result=-42;return;}
    if(trimmed.indexOfFrom("",999)!=11){result=-43;return;}
    if(trimmed.lastIndexOf("")!=11){result=-44;return;}
    if(trimmed.startsWith("")!=1){result=-45;return;}
    if(trimmed.endsWith("")!=1){result=-46;return;}
    // Updated rules: trim recognizes ASCII TAB/LF/CR and space.
    var SimpleString whitespace;
    whitespace.appendChar(cast(char,9));
    whitespace.appendChar(cast(char,10));
    whitespace.append(" abc ");
    whitespace.appendChar(cast(char,13));
    var SimpleString cleaned;
    whitespace.trim(cleaned);
    if(cleaned.equals("abc")!=1){result=-47;return;}
    var SimpleString blanks("   ");
    blanks.trim(cleaned);
    if(cleaned.isEmpty()!=1){result=-48;return;}
    result=1;
    return;
}
